{
  "description": "Report agent lifecycle states to zellij-smart-tabs in the originating pane.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/zellij/integrations/pane-status.sh\" idle",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/zellij/integrations/pane-status.sh\" running",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/zellij/integrations/pane-status.sh\" running",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/zellij/integrations/pane-status.sh\" pending",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/zellij/integrations/pane-status.sh\" pending",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/zellij/integrations/pane-status.sh\" done; printf '{}'",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/zellij/integrations/pane-status.sh\" idle",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/zellij/integrations/pane-status.sh\" idle",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
